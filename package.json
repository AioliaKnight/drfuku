{
  "name": "hemorrhoid-doctor",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.12.0"
  },
  "scripts": {
    "dev": "run-p dev:*",
    "dev:next": "cross-env NODE_OPTIONS=--disable-warning=ExperimentalWarning next dev --webpack",
    "dev:velite": "cross-env NODE_OPTIONS=--disable-warning=ExperimentalWarning velite --watch",
    "build": "velite && cross-env NODE_OPTIONS=--disable-warning=ExperimentalWarning next build --webpack",
    "start": "next start",
    "lint": "next lint .",
    "lint:fix": "next lint . --fix",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.2.0",
    "@tailwindcss/typography": "^0.5.20",
    "clsx": "^2.1.1",
    "critters": "^0.0.25",
    "date-fns": "^4.4.0",
    "framer-motion": "^12.43.0",
    "next": "^16.3.0",
    "next-pwa": "^5.6.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-error-boundary": "^6.1.2",
    "react-icons": "^5.7.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.6.0",
    "velite": "^0.2.4",
    "zod": "^3.25.63"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/estree": "^1.0.8",
    "@types/estree-jsx": "^1.0.5",
    "@types/hast": "^3.0.4",
    "@types/mdast": "^4.0.4",
    "@types/mdx": "^2.0.13",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/unist": "^3.0.3",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "eslint-config-prettier": "^10.1.5",
    "husky": "^9.1.7",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.6.12",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
